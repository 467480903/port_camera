  {
    "id": "9c87c1da2c9f55ba",
    "type": "function",
    "z": "e5b6339a0f552a15",
    "name": "do auto right",
    "func": "// 分段线性插值函数\nfunction getValuesByDistance(distance) {\n    // 数据点按distance排序\n    const dataPoints = [\n\n\n        { distance: 31, focus: 3683, zoom: 1183 },\n        { distance: 405, focus: 3992, zoom: 1133 },\n        { distance: 804, focus: 4420, zoom: 1063 },\n        { distance: 1202, focus: 4905, zoom: 983 }, \n        { distance: 1606, focus: 5312, zoom: 913 },\n        { distance: 2004, focus: 5991, zoom: 793 },\n        { distance: 2402, focus: 6705, zoom: 653 },\n        { distance: 2806, focus: 7566, zoom: 473 },\n        { distance: 3204, focus: 8594, zoom: 237 },\n        { distance: 3620, focus: 9452, zoom: 10 },\n\n    ];\n    \n    // 边界情况：小于最小值\n    if (distance <= dataPoints[0].distance) {\n        return {\n            focus: dataPoints[0].focus,\n            zoom: dataPoints[0].zoom\n        };\n    }\n    \n    // 边界情况：大于最大值\n    if (distance >= dataPoints[dataPoints.length - 1].distance) {\n        const lastPoint = dataPoints[dataPoints.length - 1];\n        return {\n            focus: lastPoint.focus,\n            zoom: lastPoint.zoom\n        };\n    }\n    \n    // 查找插值区间并进行线性插值\n    for (let i = 0; i < dataPoints.length - 1; i++) {\n        const p1 = dataPoints[i];\n        const p2 = dataPoints[i + 1];\n        \n        if (distance >= p1.distance && distance <= p2.distance) {\n            // 计算插值系数\n            const t = (distance - p1.distance) / (p2.distance - p1.distance);\n            \n            // 线性插值计算\n            const focus = Math.round(p1.focus + (p2.focus - p1.focus) * t);\n            const zoom = Math.round(p1.zoom + (p2.zoom - p1.zoom) * t);\n            \n            return {\n                focus: focus,\n                zoom: zoom\n            };\n        }\n    }\n}\n\nvar obj = getValuesByDistance(  global.get(\"plc1\")  );\nglobal.set(\"cam2zoom\",obj.zoom);\nglobal.set(\"cam2focus\", obj.focus);\n\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
